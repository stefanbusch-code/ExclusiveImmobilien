{% extends 'base.html.twig' %}

{% block body %}
    <div class="container" style="margin-top: 100px;">

        <div class="max-w-screen-xl mx-auto p-4 text-center">

                <h1 class="mb-4 text-4xl font-extrabold leading-none tracking-tight text-gray-900 md:text-5xl lg:text-6xl dark:text-white">Meine <span class="text-blue-600 dark:text-blue-500">Merkliste</span></h1>

        </div>

            {% if wishlists is not empty %}

                <div class="max-w-screen-xl mx-auto p-4 lg:mb-16">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for item in wishlists %}
                            <div class="flex flex-col h-full bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">

                                <a href="{{ path('app_create_property.show',{id: item.property.id})}}" class="block aspect-w-16 aspect-h-9">
                                    <img class="w-full h-48 object-cover rounded-t-lg"
                                         src="{{ asset('bilder/' ~ item.property.bild) }}"
                                         alt="{{ item.property.propertyTitle}}">
                                </a>

                                <div class="p-5 flex flex-col flex-grow">
                                    <a href="{{ path('app_create_property.show', {id: item.property.id}) }}">
                                        <h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900 dark:text-white line-clamp-2">
                                            {{ item.property.propertyTitle }}
                                        </h5>
                                    </a>

                                    <p class="text-gray-600 dark:text-gray-300 mb-4">
                                        {{ item.property.category }} | {{ item.property.preis|number_format(0, ',', '.') }} €
                                    </p>

                                    <div class="mt-auto flex justify-between space-x-2">
                                        <a href="{{ path('app_create_property.show',{id: item.property.id})}}"
                                           class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                                            Mehr Infos
                                        </a>
                                        <a href="{{ path('app_wishlist_delete', {id: item.id}) }}" class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-red-700 rounded-lg hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800">
                                            entfernen
                                        </a>


                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% else %}

                    <div class="max-w-screen-xl mx-auto p-4 text-center">
                        <p class="text-gray-600 dark:text-gray-300 text-lg mb-4">Deine Merkliste ist leer!</p>
                        <a href="{{ path('app_house_all') }}" class="text-blue-600 hover:underline dark:text-blue-500">
                            Zu den Immobilien
                        </a>
                    </div>

                {% endif %}

        </div>

{% endblock %}
