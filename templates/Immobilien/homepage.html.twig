{% extends 'base.html.twig' %}

{% block title %}Home | {{ parent() }}{% endblock %}

{% block body %}

    <div class="container" style="margin-top: 100px;">


        <div class="row mt-5">


            <section class="bg-white dark:bg-gray-900 lg:mb-16">
                <div class="grid max-w-screen-xl px-4 py-8 mx-auto lg:gap-8 xl:gap-0 lg:py-16 lg:grid-cols-12">
                    <div class="mr-auto place-self-center lg:col-span-7">
                        <h1 class="max-w-2xl mb-4 text-4xl font-extrabold tracking-tight leading-none md:text-5xl xl:text-6xl dark:text-black">Einziehen und in Luxus schwelgen</h1>
                        <p class="max-w-2xl mb-6 font-light text-gray-500 lg:mb-8 md:text-lg lg:text-xl dark:text-gray-400">Schau dir alle Exclusiven Immobilien im Kundenportal an. Jetzt registrieren!</p>
                        <a href="{{ path('app_registration_user') }}" class="inline-flex items-center justify-center px-5 py-3 mr-3 text-base font-medium text-center text-white rounded-lg bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-900">
                            Jetzt Registrieren
                            <svg class="w-5 h-5 ml-2 -mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                        </a>
                        <a href="{{ path('app_contact') }}" class="inline-flex items-center justify-center px-5 py-3 text-base font-medium text-center text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 dark:text-white dark:border-gray-700 dark:hover:bg-gray-700 dark:focus:ring-gray-800">
                            Kontakt
                        </a>
                    </div>

                    <div class="hidden lg:mt-0 lg:col-span-5 lg:flex">
                        <img src="{{ asset('Bilder/LuxusHaus1.jpg')}}">
                    </div>

                </div>
            </section>



            <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4 mb-16">
                <div class="text-center">
                    <h1 class="mb-4 text-4xl font-extrabold leading-none tracking-tight text-gray-900 md:text-5xl lg:text-6xl dark:text-white">Exclusive Immobilien <span class="underline underline-offset-3 decoration-8 decoration-blue-400 dark:decoration-blue-600">zum Wohlfühlen</span></h1>
                    <p class="text-lg font-normal text-gray-500 lg:text-xl dark:text-gray-400">Unsere Immobilien bringen dich in dein neues Zuhause! Häuser und Apartments auf dem höchsten Niveau mit allen annehmlichkeiten die man sich vorstellen kann.</p>
                </div>
            </div>



            <div>
            <section class="bg-white dark:bg-gray-900">
                <div class="gap-8 items-center py-8 px-4 mx-auto max-w-screen-xl xl:gap-16 md:grid md:grid-cols-2 sm:py-16 lg:px-6">

                        <div>
                            <img class="w-full dark:hidden" src="{{ asset('Bilder/AppartmentMitBlick.jpg') }}" alt="Appartment mit Blick">
                        </div>

                    <div class="mt-4 md:mt-0">
                        <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white">Apartments die sofort verzaubern.</h2>
                        <p class="mb-6 font-light text-gray-500 md:text-lg dark:text-gray-400">Apartments, mit Sauna, Infinity-Pool und riesiger Terrasse mit Blick aufs Meer. Das und noch mehr bieten unsere Luxuswohnungen. Mieten oder kaufen? Egal wie, beides findest du bei uns im Portal.</p>
                        <a href="{{ path('app_registration_user') }}" class="inline-flex items-center justify-center px-5 py-3 mr-3 text-base font-medium text-center text-white rounded-lg bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-900">
                            Jetzt Registrieren
                            <svg class="w-5 h-5 ml-2 -mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                        </a>
                    </div>
                </div>
            </section>
            </div>

            <div>
                <section class="bg-white dark:bg-gray-900 lg:mb-16">
                    <div class="gap-8 items-center py-8 px-4 mx-auto max-w-screen-xl xl:gap-16 md:grid md:grid-cols-2 sm:py-16 lg:px-6">

                        <div class="mt-4 md:mt-0">
                            <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white">Häuser mit allen Schnick Schnack.</h2>
                            <p class="mb-6 font-light text-gray-500 md:text-lg dark:text-gray-400">Häuser die alle annehmlichkeiten vereinen. Jedes ein Meisterwerk für sich. Anschauen... Mieten oder kaufen... Einziehen... Wohlfühlen...</p>
                            <a href="{{ path('app_registration_user') }}" class="inline-flex items-center justify-center px-5 py-3 mr-3 text-base font-medium text-center text-white rounded-lg bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 dark:focus:ring-blue-900">
                                Jetzt Registrieren
                                <svg class="w-5 h-5 ml-2 -mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                            </a>
                        </div>

                        <div>
                            <img class="w-full dark:hidden" src="{{ asset('Bilder/LuxusHaus.jpg') }}" alt="Luxus Haus">
                        </div>
                    </div>
                </section>
            </div>

            <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
                <div class="text-center">
                    <h1 class="mb-4 text-4xl font-extrabold leading-none tracking-tight text-gray-900 md:text-5xl lg:text-6xl dark:text-white">Ein paar <span class="text-blue-600 dark:text-blue-500">Beispiel</span> Immobilien.</h1>
                    <p class="text-lg font-normal text-gray-500 lg:text-xl dark:text-gray-400">Registriere dich um alle wichtigen Information zu erhalten und Jede Immobilie zu sehen. Die Immobilien werden Exclusiv vermarktet, welche von den kunden nicht öffentlich zur Schau gestellt werden.</p>
                </div>
            </div>

            <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4 lg:mb-16">
                    {% set randomProperties = properties|shuffle|slice(0, 3) %}
                    {% for property in randomProperties %}

                        <div class="max-w-sm bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
                            <a href="#">
                                <img class="w-full h-48 object-cover rounded-t-lg" src="{{ asset('bilder/' ~ property.bild) }}" alt="{{ property.propertyTitle}}" />
                            </a>
                            <div class="p-5">
                                <a href="#">
                                    <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">{{ property.propertyTitle }}</h5>
                                </a>
                                <p class="mb-3 font-normal text-gray-700 dark:text-gray-400">Um mehr Details zu sehen, registriere dich.</p>
                                <a href="{{ path('app_registration_user') }}" class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                                    Mehr Infos
                                    <svg class="rtl:rotate-180 w-3.5 h-3.5 ms-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
                                    </svg>
                                </a>
                            </div>
                        </div>


                    {% endfor %}
            </div>


            <section class="bg-white dark:bg-gray-900 lg:mb-16">
                <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6">
                    <div class="mx-auto max-w-screen-sm text-center">
                        <h2 class="mb-4 text-4xl tracking-tight font-extrabold leading-tight text-gray-900 dark:text-white">Finde deine Traumimmobilie mit uns</h2>
                        <p class="mb-6 font-light text-gray-500 dark:text-gray-400 md:text-lg">Exclusive Wohnungen und Häuser im kostenlosen Kunenbereich</p>
                        <a href="{{ path('app_registration_user') }}" class="inline-flex items-center justify-center px-5 py-3 mr-3 text-base font-medium text-center text-white rounded-lg bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-primary-300 dark:focus:ring-primary-900">
                            Jetzt Registrieren
                            <svg class="w-5 h-5 ml-2 -mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                        </a>
                        <a href="{{ path('app_contact') }}" class="inline-flex items-center justify-center px-5 py-3 text-base font-medium text-center text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 dark:text-white dark:border-gray-700 dark:hover:bg-gray-700 dark:focus:ring-gray-800">
                            Kontakt
                        </a>
                    </div>
                </div>
            </section>

{% endblock %}
