{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mx-auto px-4 py-8" style="margin-top: 100px";>
        <section class="bg-gray-50 dark:bg-gray-900">

    <div class="max-w-screen-xl mx-auto p-4 text-center">
        <h1 class="mb-4 text-4xl font-extrabold leading-none tracking-tight text-gray-900 md:text-5xl lg:text-6xl dark:text-white">Immobilie <span class="text-blue-600 dark:text-blue-500">bearbeiten</span></h1>
    </div>

    <div class="flex flex-col items-center justify-center px-4 py-8 mx-auto lg:py-0">

        <div class="w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
            <div class="p-6 space-y-6 md:space-y-8 sm:p-8">

                {% for flash in app.flashes('success') %}
                    <div class="p-4 text-sm text-green-800 rounded-lg bg-green-50 dark:bg-gray-800 dark:text-green-400">
                        {{ flash }}
                    </div>
                {% endfor %}

                {{ form_start(propertyForm, {'attr': {'class': 'space-y-6'}, 'multipart': true}) }}


                {{ form_row(propertyForm.property_title, {
                    'label': 'Titel',
                    'attr': {
                        'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500',
                        'placeholder': 'Max'
                    }
                }) }}

                {{ form_row(propertyForm.property_discription, {
                    'label': 'Beschreibung',
                    'attr': {
                        'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500',
                        'placeholder': 'Mustermann'
                    }
                }) }}


                {{ form_row(propertyForm.preis, {
                    'label': 'Preis',
                    'attr': {
                        'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500',
                        'placeholder': '1.000.000'
                    }
                }) }}

                <div class="grid gap-6 md:grid-cols-2">
                    {{ form_row(propertyForm.location.location_zipcode, {
                        'label': 'PLZ',
                        'attr': {
                            'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500',
                            'placeholder': '123456'
                        }
                    }) }}

                    {{ form_row(propertyForm.location.location_town, {
                        'label': 'Stadt',
                        'attr': {
                            'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500',
                            'placeholder': 'Musterstadt'
                        }
                    }) }}
                </div>

                <div class="grid gap-6 md:grid-cols-2">
                    {{ form_row(propertyForm.location.location_street, {
                        'label': 'Straße',
                        'attr': {
                            'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500',
                            'placeholder': 'Musterstraße'
                        }
                    }) }}

                    {{ form_row(propertyForm.location.location_streetnumber, {
                        'label': 'Hausnummer',
                        'attr': {
                            'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500',
                            'placeholder': 'Musterstadt'
                        }
                    }) }}
                </div>


                {{ form_row(propertyForm.location.region, {
                    'label': 'Bundesland',
                    'attr': {
                        'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500',
                        'placeholder': 'Bayern'
                    }
                }) }}


                {{ form_row(propertyForm.location.country, {
                    'label': 'Land',
                    'attr': {
                        'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500',
                        'placeholder': 'Deutschland'
                    }
                }) }}

                {{ form_row(propertyForm.category, {
                    'label': 'Kategorie',
                    'attr': {
                        'class': 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500',
                        'placeholder': 'Bitte wählen'
                    }
                }) }}

                {{ form_row(propertyForm.bild,{
                    'label': 'Bild hochladen'
                }) }}

                <button type="submit" class="w-full text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                    Speichern
                </button>

                {{ form_end(propertyForm) }}
            </div>
        </div>
    </div>
{% endblock %}