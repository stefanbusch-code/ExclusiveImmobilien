{% extends 'base.html.twig' %}

{% block title %}2-Faktor-Authentifizierung Einstellungen{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8" style="margin-top: 100px;">

        <section class="bg-gray-50 dark:bg-gray-900">

            <form method="post" action="{{ path('app_dashboard_2fa_settings') }}">

                <div class="max-w-screen-xl mx-auto p-4 text-center">
                    <h1 class="mb-4 text-4xl font-extrabold leading-none tracking-tight text-gray-900 md:text-5xl lg:text-6xl dark:text-white">Meine <span class="text-blue-600 dark:text-blue-500">Sicherheit</span></h1>
                </div>

                    <div class="flex flex-col items-center justify-center px-4 py-8 mx-auto lg:py-0">

                        <div class="w-full bg-white rounded-lg shadow dark:border md:mt-0 sm:max-w-md xl:p-0 dark:bg-gray-800 dark:border-gray-700">
                            <div class="p-6 space-y-6 md:space-y-8 sm:p-8">

                                <div class="flex items-center ps-4 border border-gray-200 rounded-sm dark:border-gray-700">
                                    <input id="2fa_none" type="radio" value="none" name="2fa_provider" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600"
                                            {{ currentProvider is null ? 'checked' }}>
                                    <label for="2fa_none" class="w-full py-4 ms-2 text-sm font-medium text-gray-900 dark:text-gray-300">2FA deaktivieren</label>
                                </div>
                                <div class="flex items-center ps-4 border border-gray-200 rounded-sm dark:border-gray-700">
                                    <input id="2fa_email" type="radio" value="email" name="2fa_provider" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600"
                                            {{ currentProvider == 'email' ? 'checked' }}>
                                    <label for="2fa_email" class="w-full py-4 ms-2 text-sm font-medium text-gray-900 dark:text-gray-300">Email-Verifizierung</label>
                                </div>

                                <div class="border border-gray-200 rounded-sm dark:border-gray-700 p-4">
                                    <div class="flex items-center">
                                        <input id="2fa_totp" type="radio" value="totp" name="2fa_provider"
                                               class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600"
                                                {{ currentProvider == 'totp' ? 'checked' }}
                                                {{ not isTotpEnabled ? 'disabled' }}>
                                        <label for="2fa_totp" class="ml-2 text-sm font-medium text-gray-900 dark:text-gray-300">
                                            Authenticator App (TOTP)
                                            {% if not isTotpEnabled %}
                                                <small class="text-red-500 dark:text-red-500">- Sie müssen erst TOTP einrichten</small>
                                            {% endif %}
                                        </label>
                                    </div>


                                        <div id="qr-setup-container" class="hidden mt-4 text-center">
                                            <p class="text-sm text-gray-800 dark:text-gray-200 mb-2">
                                                Bitte scannen Sie den folgenden QR-Code mit Ihrer Authenticator App:
                                            </p>
                                            <img src="{{ path('app_authenticate_2fa_qr_code') }}" alt="QR-Code" class="mx-auto w-48 h-48 border p-2 bg-white rounded">
                                            <p class="text-sm mt-2 text-gray-600 dark:text-gray-400">
                                                Falls Sie keinen QR-Code sehen, stellen Sie sicher, dass JavaScript aktiviert ist.
                                            </p>
                                        </div>

                                </div>
                                
                                <button type="submit" class="w-full text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                                    Speichern
                                </button>

                            </div>
                        </div>
                    </div>
            </form>
        </section>

    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const totpRadio = document.getElementById('2fa_totp');
            const qrContainer = document.getElementById('qr-setup-container');
            const emailRadio = document.getElementById('2fa_email');
            const noneRadio = document.getElementById('2fa_none');

            function toggleQrVisibility() {
                if (totpRadio.checked && !totpRadio.disabled) {
                    qrContainer.classList.remove('hidden');
                } else {
                    qrContainer.classList.add('hidden');
                }
            }

            totpRadio.addEventListener('change', toggleQrVisibility);
            emailRadio.addEventListener('change', toggleQrVisibility);
            noneRadio.addEventListener('change', toggleQrVisibility);

            // Initialzustand setzen beim Laden der Seite
            toggleQrVisibility();
        });
    </script>

{% endblock %}
