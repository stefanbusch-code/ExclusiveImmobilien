{% extends 'base.html.twig' %}

{% block body %}
    <div class="container" style="margin-top: 100px;">
        <div class="max-w-screen-xl mx-auto p-4 text-center">

            <h1 class="mb-4 text-4xl font-extrabold leading-none tracking-tight text-gray-900 md:text-5xl lg:text-6xl dark:text-white">Meine <span class="text-blue-600 dark:text-blue-500">Daten</span></h1>

        </div>

        <div class="max-w-screen-xl mx-auto p-4 lg:mb-16">

            <dl class="max-w-md text-gray-900 divide-y divide-gray-200 dark:text-white dark:divide-gray-700">
                <div class="flex flex-col pb-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">E-Mail-Address:</dt>
                    <dd class="text-lg font-semibold">{{ email }}</dd>
                </div>
                <div class="flex flex-col py-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Vorname:</dt>
                    <dd class="text-lg font-semibold">{{ customer.firstname }}</dd>
                </div>
                <div class="flex flex-col pt-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Nachname:</dt>
                    <dd class="text-lg font-semibold">{{ customer.lastname }}</dd>
                </div>
                <div class="flex flex-col pt-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Telefonnummer:</dt>
                    <dd class="text-lg font-semibold">{{ customer.phone }}</dd>
                </div>
                <div class="flex flex-col pt-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Straße & Hausnummer:</dt>
                    <dd class="text-lg font-semibold">{{ customer.street }} {{ customer.streetnumber }}</dd>
                </div>
                <div class="flex flex-col pt-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">PLZ:</dt>
                    <dd class="text-lg font-semibold">{{ customer.zipcode }}</dd>
                </div>
                <div class="flex flex-col pt-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Stadt:</dt>
                    <dd class="text-lg font-semibold">{{ customer.city }}</dd>
                </div>
                <div class="flex flex-col pt-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Bundesland:</dt>
                    <dd class="text-lg font-semibold">{{ customer.state }}</dd>
                </div>
                <div class="flex flex-col pt-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Land:</dt>
                    <dd class="text-lg font-semibold">{{ customer.country }}</dd>
                </div>
            </dl>

            <br>

            <div class="mt-3">
                <a class="flex-1 text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-re-800"
                   href="{{ path('app_customer_data_edit') }}">Daten ändern</a>
            </div>

        </div>
    </div>
{% endblock %}
