{#
Haupttemplate für die Immobilien-Übersichtseite

Zeigt das gesamte Immobilienportfolio mit Such- und Filterfunktionen.
Implementiert eine resonsive, grid basierte Darstellung mit Filteroptionen für Standort, Preisbereich und Katgorien.
#}

{% extends 'base.html.twig' %}

{% block body %}

    <div class="container" style="margin-top: 100px;">


        {% if not app.user %}

            <div id="modal-backdrop" class="fixed inset-0 bg-gray-900/70 backdrop-blur z-40"></div>

            <div id="authentication-modal" tabindex="-1" aria-hidden="false"
                 class="overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 flex justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">        <div class="relative p-4 w-full max-w-md max-h-full">
                    <!-- Modal content -->
                    <div class="relative bg-white rounded-lg shadow-sm dark:bg-gray-700">
                        <!-- Modal header -->
                        <div class="flex flex-col p-4 md:p-5 border-b rounded-t dark:border-gray-600 border-gray-200">
                            <div class="flex items-center justify-between">
                                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
                                    Um alle Immobilien zu sehen, bitte anmelden
                                </h3>
                                <button type="button" onclick="closeModalAndRedirect()" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white">
                                    <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                                    </svg>
                                    <span class="sr-only">Modal schließen und zur Startseite</span>
                                </button>
                            </div>
                            {% for flash in app.flashes('success') %}
                                <div class="alert alert-success">{{ flash }}</div>
                            {% endfor %}
                            {% for flash in app.flashes('error') %}
                                <div class="alert alert-danger">{{ flash }}</div>
                            {% endfor %}

                            {% if app.request.hasPreviousSession and app.session.get('_security.last_error') %}
                                {% set error = app.session.get('_security.last_error') %}
                                {% if error.messageKey == 'Invalid credentials.' %}
                                    <div class="alert alert-danger">Falsche Anmeldedaten. Bitte versuchen Sie es erneut.</div>
                                {% else %}
                                    <div class="alert alert-danger">Anmeldefehler: {{ error.messageKey|trans(error.messageData, 'security') }}</div>
                                {% endif %}
                            {% endif %}


                            <form class="space-y-4 md:space-y-6" method="post" action="{{ path('app_login')}}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                <div>
                                    <label for="inputEmail" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Deine E-Mail-Adresse</label>
                                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" placeholder="name@company.com" required="">
                                </div>
                                <div>
                                    <label for="inputPassword" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Passwort</label>
                                    <input type="password" name="password" id="inputPassword" placeholder="••••••••" class="bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" required="">
                                </div>
                                <div class="flex items-center justify-between">
                                    <div class="flex items-start">
                                        <div class="flex items-center h-5">
                                            <input id="remember" aria-describedby="remember" type="checkbox" class="w-4 h-4 border border-gray-300 rounded bg-gray-50 focus:ring-3 focus:ring-primary-300 dark:bg-gray-700 dark:border-gray-600 dark:focus:ring-primary-600 dark:ring-offset-gray-800">
                                        </div>
                                        <div class="ml-3 text-sm">
                                            <label for="remember" class="text-gray-500 dark:text-gray-300">An mich erinnern</label>
                                        </div>
                                    </div>
                                    <a href="{{ path('app_forgot_password_request') }}" class="text-sm font-medium text-primary-600 hover:underline dark:text-primary-500">Passwort vergessen?</a>
                                </div>
                                <button type="submit" class="w-full text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">Anmelden</button>
                                <p class="text-sm font-light text-gray-500 dark:text-gray-400">
                                    Ich habe noch kein Kundenkonto <a href="{{ path('app_registration_user') }}" class="font-medium text-primary-600 hover:underline dark:text-primary-500">Registrieren</a>
                                </p>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if app.user %}

        {# Fehler-Nachricht Anzeige #}
        {% for flash in app.flashes('error') %}
            <div class="max-w-screen-xl mx-auto p-4">
                <div class="p-4 mb-4 text-red-800 bg-red-50 rounded-lg">
                    {{ flash }}
                </div>
            </div>
        {% endfor %}

        {# Hauptcontainer für die Seite #}
        <div class="max-w-screen-xl mx-auto p-4 mb-16 text-center">


            {# Herosection mit Hauptüberschrift #}
            <div class="max-w-screen-xl mx-auto p-4 mb-16 text-center">
                <h1 class="mb-4 text-4xl font-extrabold leading-none tracking-tight text-gray-900
            md:text-5xl lg:text-6xl dark:text-white">
                    Finde deine <span class="text-blue-600 dark:text-blue-500">Traum </span> Immobilie.</h1>
                <p class="text-lg font-normal text-gray-500 lg:text-xl dark:text-gray-400">
                    Auf der Suche zum Zuhause im Glück und Luxus.</p>
            </div>

            {# Hauptbereich mit Filter, Suche und Immobilienliste #}
            <section>

                <div class="text-left">

                    {# Schnellfilter-Kategorien #}
                    <div class="max-w-screen-xl mx-auto p-4 mb-1">
                        <h2 class="text-4xl font-bold ">Filtern nach:</h2>

                        {# Horizontale Liste mit Kategorie-Links für schnelle Filterung #}
                        <ul class="flex flex-wrap gap-2 mt-2 mb-3 list-none ps-0">
                            <li class="d-inline">
                                <a class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4
                                focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2
                                text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
                                   href="{{ path('app_house_all', {
                                       slug: 'Apartments zum Kaufen'
                                   }) }}">Apartments zum Kaufen</a>
                            </li>
                            <li class="d-inline">
                                <a class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4
                                focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2
                                text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
                                   href="{{ path('app_house_all', {
                                       slug: 'Apartments zum Mieten'
                                   }) }}">Apartments zum Mieten</a>
                            </li>
                            <li class="d-inline">
                                <a class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4
                                focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2
                                text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
                                   href="{{ path('app_house_all', {
                                       slug: 'Häuser zum Kaufen'
                                   }) }}">Häuser zum Kaufen</a>
                            </li>
                            <li class="d-inline">
                                <a class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4
                                focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2
                                text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
                                   href="{{ path('app_house_all', {
                                       slug: 'Häuser zum Mieten'
                                   }) }}">Häuser zum Mieten</a>
                            </li>
                            <li class="d-inline">
                                {# Link zum zurücksetzen - zeigt alle Immobilien ohne Filter an #}
                                <a class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4
                                focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2
                                text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
                                   href="{{ path('app_house_all') }}">Alle Immobilien</a>
                            </li>
                        </ul>
                    </div>

                    {# Volltextsuche-Formular #}
                    <form method="get" action="{{ path('app_house_all', {slug: category ? category.discription : null}) }}"
                          class="max-w-screen-md p-4 mb-1">

                        {# CSRF-Token Protection für authentifizierte Benutzer #}
                        {% if app.user %}
                            <input type="hidden" name="_token" value="{{ csrf_token('property_filters') }}">
                        {% endif %}

                        {# Suchleiste mit Icon und Button #}
                        <label for="search" class="mb-2 text-sm font-medium text-gray-900 sr-only dark:text-white">
                            Search</label>
                        <div class="relative">

                            {# Such-icon #}
                            <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
                                <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true"
                                     xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                          stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
                                </svg>
                            </div>

                            {# Such-Eingabefeld - behält vorherige Suchbegriffe #}
                            <input type="search" id="search" name="search" class="block w-full p-4 pl-10 text-sm
                        text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500
                        focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400
                        dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                                   placeholder="suchen" value="{{ searchTerm ?? '' }}" />

                            {# Such-Button #}
                            <button type="submit" class="text-white absolute end-2.5 bottom-2.5 bg-blue-700
                        hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium
                        rounded-lg text-sm px-4 py-2 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                                suchen</button>
                        </div>
                    </form>

                    {# Erweiterte Filter-Section #}
                    <div class="max-w-screen-xl mx-auto p-4 mb-10">
                        <h3 class="text-3xl font-bold">weitere Filter:</h3>

                        {# Hauptfilterformular für erweiterte Filteroptionen #}
                        <form method="get" action="{{ path('app_house_all',
                            {slug:category ? category.discription : null}) }}">

                        {% if app.user %}
                            <input type="hidden" name="_token" value="{{ csrf_token('property_filters') }}">
                        {% endif %}

                            {# CSRF-Protection #}
                            {% if app.user %}
                                <input type="hidden" name="_token" value="{{ csrf_token('property_filters') }}">
                            {% endif %}

                            {# Suchbegriff beibehalten wenn vorhanden #}
                            {% if searchTerm %}
                                <input type="hidden" name="search" value="{{ searchTerm }}">
                            {% endif %}

                            {# Responsive Filter-Optionen in Flexbox Layout #}
                            <div class="flex flex-wrap gap-2 mt-2 mb-3 list-none ps-0 justify-start">
                                <div class="max-w-sm">
                                    <label for="Preis" class="block mb-2 text-sm font-medium text-gray-900
                                dark:text-white">Preisspanne wählen</label>
                                    <select class="form-select" name="preis" id="preis" class="bg-gray-50 border
                                border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500
                                focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600
                                dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500
                                dark:focus:border-blue-500">
                                        <option value="">Beliebig</option>

                                        {# Dynamisch generierte Preisbereiche aus dem Controller #}
                                        {% for label, range in priceRanges %}
                                            <option value="{{ range[0] ~ '-' ~ range[1] }}"
                                                    {{ selectedPreis == (range[0] ~ '-' ~ range[1]) ? 'selected' : '' }}>
                                                {{ label }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>

                                {# Stadt Dropdown #}
                                <div class="max-w-sm">
                                    <label for="Stadt" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                                        Stadt wählen</label>
                                    <select class="form-select" name="town" id="towns" class="bg-gray-50 border
                                border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500
                                focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600
                                dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500
                                dark:focus:border-blue-500">
                                        <option value="">Alle Städte</option>

                                        {# Dynamisch aus der Datenbank geladene Städte #}
                                        {% for t in towns %}
                                            <option value="{{ t }}" {{ selectedTown == t ? 'selected' : '' }}>
                                                {{ t }}</option>
                                        {% endfor %}
                                    </select>
                                </div>

                                {# Region Dropdown #}
                                <div class="max-w-sm">
                                    <label for="Region" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                                        Region wählen</label>
                                    <select class="form-select" name="region" id="region" class="bg-gray-50 border
                                border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500
                                focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600
                                dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500
                                dark:focus:border-blue-500">
                                        <option value="">Alle Regionen</option>

                                        {# Dynamisch aus Datenbank geladene Regionen #}
                                        {% for r in regions %}
                                            <option value="{{ r }}" {{ selectedRegion == r ? 'selected' : '' }}>
                                                {{ r }}</option>
                                        {% endfor %}
                                    </select>
                                </div>

                                {# Land Dropdown #}
                                <div class="max-w-sm">
                                    <label for="country" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                                        Land wählen</label>
                                    <select class="form-select" name="country" id="countries" class="bg-gray-50 border
                                border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500
                                focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600
                                dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500
                                dark:focus:border-blue-500">
                                        <option value="">Alle Länder</option>

                                        {# Dynamisch aus Datenbank geladene Länder #}
                                        {% for c in countries %}
                                            <option value="{{ c }}" {{ selectedCountry == c ? 'selected' : '' }}>
                                                {{ c }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>

                            {# Formular-Actions #}
                            <div class="mt-3">
                                {# Wendet die gesetzten Filter an #}
                                <button type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4
                            focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2
                            text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                                    Anwenden</button>
                                {# Zurücksetzen-Button - entfernt alle Filter #}
                                <a class="flex-1 text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:outline-none
                            focus:ring-red-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-red-600
                            dark:hover:bg-red-700 dark:focus:ring-re-800"
                                   href="{{ path('app_house_all') }}">Zurücksetzen</a>
                            </div>

                        </form>
                    </div>
                </div>

                {# Immobilien Ergenisliste #}
                <div>

                    {# Grid-basierte Immobilienanzeige #}
                    <div class="max-w-screen-xl mx-auto p-4 lg:mb-16">
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                            {# Loop durch alle gefilterten Immobilien #}
                            {% for property in properties %}
                                {# Immobilien-Karte #}
                                <div class="flex flex-col h-full bg-white border border-gray-200 rounded-lg shadow-sm
                            dark:bg-gray-800 dark:border-gray-700">

                                    {# Bild mit Link zur Detailseite #}
                                    <a href="{{ path('app_create_property.show',{id: property.id})}}"
                                       class="block aspect-w-16 aspect-h-9">
                                        <img class="w-full h-48 object-cover rounded-t-lg"
                                             src="{{ asset('Bilder/' ~ property.bild) }}"
                                             alt="{{ property.propertyTitle}}">
                                    </a>

                                    {# Immobilien Informationen #}
                                    <div class="p-5 flex flex-col flex-grow">
                                        <a href="#">
                                            <h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900
                                        dark:text-white line-clamp-2">
                                                {{ property.propertyTitle }}
                                            </h5>
                                        </a>

                                        <p class="text-gray-600 dark:text-gray-300 mb-4">
                                            {{ property.category }} | {{ property.preis|number_format(0, ',', '.') }} €
                                        </p>

                                        {# Action-Buttons #}
                                        <div class="mt-auto flex justify-between space-x-2">

                                            {# Detailseiten-Link mit Filter-Parametern für Rücknavigation #}
                                            <a href="{{ path('app_create_property.show', {
                                                id: property.id,
                                                preis: selectedPreis,
                                                towns: selectedTown ? selectedTown|join(',') : '',
                                                region: selectedRegion ? selectedRegion|join(',') : '',
                                                categories: selectedCategories ? selectedCategories|join(',') : '',
                                                countries: selectedCountry ? selectedCountry|join(',') : '',
                                                search: searchTerm ?? '',
                                                slug: category ? category.discription : null
                                            }) }}"
                                               class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4
                                           focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm
                                           px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700
                                           dark:focus:ring-blue-800">
                                                Mehr Infos
                                            </a>

                                            {# Merklisten Funktionalität #}
                                            {% if wishlistPropertyIds is defined and property.id in wishlistPropertyIds %}
                                                {# Bereits gemerkte Immobilie - deaktivierter Button #}
                                                <button type="submit"
                                                        class="flex-1 text-white bg-red-700 hover:bg-red-800 focus:ring-4
                                                    focus:outline-none focus:ring-red-300 font-medium rounded-lg
                                                    text-sm px-4 py-2 text-center dark:bg-red-600 dark:hover:bg-red-700
                                                    dark:focus:ring-red-800"
                                                        disabled>
                                                    Gemerkt
                                                </button>
                                            {% else %}
                                                {# Noch nicht gemerkte Immobilie - aktiver Button #}
                                                <a href="{{ path('app_wishlist_add', {id: property.id}) }}"
                                                   class="flex-1 text-white bg-green-700 hover:bg-green-800 focus:ring-4
                                               focus:outline-none focus:ring-green-300 font-medium rounded-lg text-sm
                                               px-4 py-2 text-center dark:bg-green-600 dark:hover:bg-green-700
                                               dark:focus:ring-green-800">
                                                    Merken
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {% endif %}

            </section>
        </div>
    </div>

<script>
    function closeModalAndRedirect() {
        // Modal schließen
        document.getElementById('authentication-modal').classList.add('hidden');
        document.getElementById('modal-backdrop').classList.add('hidden');

        // Zur Startseite weiterleiten
        window.location.href = '{{ path('app_property_homepage') }}';
    }

    // Event-Listener für den vorhandenen Button
    document.querySelector('[data-modal-hide="authentication-modal"]').addEventListener('click', function() {
        closeModalAndRedirect();
    });
</script>

{% endblock %}