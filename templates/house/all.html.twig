{% extends 'base.html.twig' %}

{% block body %}

<div class="container" style="margin-top: 100px;">

<div class="max-w-screen-xl mx-auto p-4 mb-16 text-center">


    <div class="max-w-screen-xl mx-auto p-4 mb-16 text-center">

        <h1 class="mb-4 text-4xl font-extrabold leading-none tracking-tight text-gray-900 md:text-5xl lg:text-6xl dark:text-white">Finde deine <span class="text-blue-600 dark:text-blue-500">Traum </span> Immobilie.</h1>
        <p class="text-lg font-normal text-gray-500 lg:text-xl dark:text-gray-400">Auf der Suche zum Zuhause im Glück und Luxus.</p>

    </div>



    <section>

        <div class="text-left">

        <div class="max-w-screen-xl mx-auto p-4 mb-1">
            <h2 class="text-4xl font-bold ">Filtern nach:</h2>

                <ul class="flex flex-wrap gap-2 mt-2 mb-3 list-none ps-0">
                    <li class="d-inline">
                        <a class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" href="{{ path('app_house_all', {
                            slug: 'Apartments zum Kaufen'
                        }) }}">Apartments zum Kaufen</a>
                    </li>
                    <li class="d-inline">
                        <a class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" href="{{ path('app_house_all', {
                            slug: 'Apartments zum Mieten'
                        }) }}">Apartments zum Mieten</a>
                    </li>
                    <li class="d-inline">
                        <a class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" href="{{ path('app_house_all', {
                            slug: 'Häuser zum Kaufen'
                        }) }}">Häuser zum Kaufen</a>
                    </li>
                    <li class="d-inline">
                        <a class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" href="{{ path('app_house_all', {
                            slug: 'Häuser zum Mieten'
                        }) }}">Häuser zum Mieten</a>
                    </li>
                    <li class="d-inline">
                        <a class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" href="{{ path('app_house_all') }}">Alle Immobilien</a>
                    </li>
                </ul>
        </div>

        <div class="max-w-screen-xl mx-auto p-4 mb-10">

            <h3 class="text-3xl font-bold">weitere Filter:</h3>


        <form method="get" action="{{ path('app_house_all', {slug:category ? category.discription : null}) }}">
            <div class="flex flex-wrap gap-2 mt-2 mb-3 list-none ps-0 justify-start">
                <div class="max-w-sm">
                    <label for="Preis" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Preisspanne wählen</label>
                    <select class="form-select" name="preis" id="preis" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                        <option value="">Beliebig</option>
                        {% for label, range in priceRanges %}
                            <option value="{{ range[0] ~ '-' ~ range[1] }}" {{ selectedPreis == (range[0] ~ '-' ~ range[1]) ? 'selected' : '' }}>
                                {{ label }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="max-w-sm">
                    <label for="Stadt" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Stadt wählen</label>
                    <select class="form-select" name="town" id="towns" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                        <option value="">Alle Städte</option>
                        {% for t in towns %}
                            <option value="{{ t }}" {{ selectedTown == t ? 'selected' : '' }}> {{ t }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="max-w-sm">
                    <label for="Region" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Region wählen</label>
                    <select class="form-select" name="region" id="region" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                        <option value="">Alle Regionen</option>
                        {% for r in regions %}
                            <option value="{{ r }}" {{ selectedRegion == r ? 'selected' : '' }}> {{ r }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="max-w-sm">
                    <label for="country" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Land wählen</label>
                    <select class="form-select" name="country" id="countries" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                        <option value="">Alle Länder</option>
                        <option value="">Alle Länder</option>
                        {% for c in countries %}
                            <option value="{{ c }}" {{ selectedCountry == c ? 'selected' : '' }}> {{ c }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>


            <div class="mt-3">
                <button type="submit" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                    Anwenden</button>
                <a class="flex-1 text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-re-800"
                   href="{{ path('app_house_all') }}">Zurücksetzen</a>
            </div>

        </form>
        </div>
    </div>


    <div>

        <div class="max-w-screen-xl mx-auto p-4 lg:mb-16">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for property in properties %}
                    <div class="flex flex-col h-full bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">

                        <a href="{{ path('app_create_property.show',{id: property.id})}}" class="block aspect-w-16 aspect-h-9">
                            <img class="w-full h-48 object-cover rounded-t-lg"
                                 src="{{ asset('Bilder/' ~ property.bild) }}"
                                 alt="{{ property.propertyTitle}}">
                        </a>

                        <div class="p-5 flex flex-col flex-grow">
                            <a href="#">
                                <h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900 dark:text-white line-clamp-2">
                                    {{ property.propertyTitle }}
                                </h5>
                            </a>

                            <p class="text-gray-600 dark:text-gray-300 mb-4">
                                {{ property.category }} | {{ property.preis|number_format(0, ',', '.') }} €
                            </p>

                            <div class="mt-auto flex justify-between space-x-2">
                                <a href="{{ path('app_create_property.show', {
                                    id: property.id,
                                    preis: selectedPreis,
                                    towns: selectedTown ? selectedTown|join(',') : '',
                                    categories: selectedCategories ? selectedCategories|join(',') : '',
                                    countries: selectedCountry ? selectedCountry|join(',') : '',
                                    slug: category ? category.discription : null
                                }) }}"
                                   class="flex-1 text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
                                    Mehr Infos
                                </a>

                                {% if wishlistPropertyIds is defined and property.id in wishlistPropertyIds %}
                                    <button type="submit"
                                            class="flex-1 text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800"
                                            disabled>
                                        Gemerkt
                                    </button>
                                {% else %}
                                    <a href="{{ path('app_wishlist_add', {id: property.id}) }}"
                                       class="flex-1 text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:outline-none focus:ring-green-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800">
                                        Merken
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>



    </section>
</div>
</div>



{% endblock %}


